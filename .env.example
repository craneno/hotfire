# Only the AI features (generate, import, grading open answers) need a key. Everything else works offline.

# Which model provider runs the AI features: google (default) or anthropic
AI_PROVIDER=google

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-4-neon        # lighter/cheaper: gemini-4-hydrogen

# Anthropic Claude (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# PORT=8787
