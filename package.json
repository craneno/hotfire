{
  "name": "hotfire",
  "version": "0.1.0",
  "description": "Interview drills for SpaceX-style mechanical engineering roles",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "npm run build && NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bank:check": "tsx scripts/check-bank.ts",
    "build:static": "tsc -p tsconfig.json --noEmit && VITE_STATIC=true vite build --base=./ && tsx scripts/export-bank.ts dist/bank.json",
    "preview:static": "npm run build:static && vite preview"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true,
  "type": "module"
}
